public class Main {
    public static void main(String[] args) {

       int n=5;
       int k=n-1;

       for(int i =1;i<=n*2-1;i++){

           for(int j=1;j<=5;j++){

               //1st half

               if(i<=n){

                   if(j<=i){

                       System.out.print("* ");
                   }
                   else{
                       System.out.print("  ");
                   }

               }

               // 2nd half

               if(i>n){

                   if(j<=k){

                       System.out.print("* ");
                   }
                   else{
                       System.out.print("  ");

                   }



               }




           }

           if(i>n){

               k--;
           }

           System.out.println();



       }

    }
}

